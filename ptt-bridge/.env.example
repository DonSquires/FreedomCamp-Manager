# PTT Bridge Service — Environment Configuration
# Copy this to .env and fill in the values

# Service port
PORT=8273

# Ollama backend for Whisper, Seamless, Piper models
# Examples:
#   Local development: http://localhost:11434
#   Docker service: http://ollama:11434
#   RunPod gateway: https://your-ollama-runpod-gateway.io
OLLAMA_PTT_BASE_URL=http://ollama:11434

# Optional: Bob inference service (backup for translation)
BOB_SERVICE_URL=http://localhost:8000
BOB_API_KEY=

# Model selection
WHISPER_MODEL=whisper-small
SEAMLESS_MODEL=seamless-smoll
PIPER_VOICE=en_NZ-fiona-medium

# Feature flags
ENABLE_CACHING=true
MAX_AUDIO_SIZE_MB=50

# Logging verbosity (debug, info, warn, error)
LOG_LEVEL=info
