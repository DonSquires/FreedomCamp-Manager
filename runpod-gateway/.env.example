# Required: shared secret callers must send as Bearer token
BOB_GATEWAY_KEY=replace-me-with-a-strong-random-secret

# Optional: elevated key for model pull/delete operations
# BOB_GATEWAY_ADMIN_KEY=replace-me-with-admin-secret

# Ollama location inside the pod (default is correct for RunPod)
OLLAMA_HOST=http://127.0.0.1:11434

# Gateway listen port (RunPod exposes this port externally)
PORT=8080

NODE_ENV=production
