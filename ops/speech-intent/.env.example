# Speech Router Runtime
PORT=8080
SPEECH_ROUTER_TIMEOUT_SECONDS=45

# Provider identity labels (observability only)
WAKEWORD_PROVIDER=sherpa-onnx/openwakeword
STT_PROVIDER=faster-whisper
INTENT_PROVIDER=ollama
TTS_PROVIDER=kokoro-onnx

# Upstream provider endpoints
# STT: Faster-Whisper on Railway (CPU, distil-small.en)
#   Service directory: railway-stt/
#   Deploy railway-stt/ as a new Railway service, then paste the public URL below.
#   See: railway-stt/railway.toml
#   Fallback option: RunPod GPU endpoint (see docs/SPEECH_STT_RUNPOD_RUNBOOK.md)
#     STT_URL=https://api.runpod.ai/v2/<stt-endpoint-id>/runsync
# Intent: Railway Ollama — already deployed, no new endpoint needed
# TTS: local Kokoro-ONNX or Piper on hPanel (CPU)
STT_URL=https://<railway-stt-service>.up.railway.app/transcribe
# Optional: set STT_API_KEY on the Railway service and here to protect the endpoint
STT_API_KEY=
INTENT_URL=https://ollama-production-3ab0.up.railway.app/api/generate
TTS_URL=http://127.0.0.1:5001/v1/tts

# Intent model selection (hosted by Railway Ollama)
# Available: llama3.1:8b (primary), qwen2.5:7b (alternative), phi3:mini (fast fallback)
INTENT_MODEL=llama3.1:8b

# OpenAI is optional and restricted to research/training workflows only.
# If INTENT_URL points to OpenAI, context.openai_purpose must be research|training
# and payload redaction is required by default.
ALLOW_OPENAI_RUNTIME=false
OPENAI_MODEL=gpt-4o-mini
OPENAI_REDACTION_REQUIRED=true
OPENAI_ALLOWED_PURPOSES=research,training

# Optional API keys for upstream services
INTENT_API_KEY=
TTS_API_KEY=

# Auth — set a strong random string in production
ROUTER_API_KEY=

# Circuit breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30

# Payload limits
SPEECH_ROUTER_MAX_AUDIO_BYTES=10485760
SPEECH_ROUTER_MAX_TTS_CHARS=2000
