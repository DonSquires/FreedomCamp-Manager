# Hostname and domain for the self-hosted mail server
MAIL_HOSTNAME=mail
MAIL_DOMAIN=fcmanager.co.nz
MAIL_FQDN=mail.fcmanager.co.nz
TZ=Pacific/Auckland

# Initial admin account for Poste.io web UI
POSTE_ADMIN=admin
POSTE_ADMIN_PASSWORD=change_this_to_a_long_random_password

# Optional relay host if you later offload outbound delivery
# RELAYHOST=

# SMTP credentials to use in application secrets after mailbox creation
# These should match a mailbox you create in Poste.io, e.g. reports@fcmanager.co.nz
SMTP_HOST=mail.fcmanager.co.nz
SMTP_PORT=587
SMTP_USERNAME=reports@fcmanager.co.nz
SMTP_PASSWORD=change_this_mailbox_password
SMTP_FROM_EMAIL=reports@fcmanager.co.nz
SMTP_FROM_NAME=Field Compliance Manager Reports
SMTP_REPORTS_FROM_EMAIL=reports@fcmanager.co.nz
SMTP_REPORTS_FROM_NAME=Field Compliance Manager Reports
