# Source-of-truth SMTP config for app stack wiring
# Enterprise baseline for this build: managed Hostinger SMTP.
# Copy to a private file (for example .env.email-prod) and set real values.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=donotreply@fcmanager.co.nz
SMTP_PASSWORD=change_this_mailbox_password
SMTP_FROM_EMAIL=donotreply@fcmanager.co.nz
SMTP_FROM_NAME=Field Compliance Manager
SMTP_REPORTS_FROM_EMAIL=reports@fcmanager.co.nz
SMTP_REPORTS_FROM_NAME=Field Compliance Manager Reports

# Relay controls for send-report-email edge function
REPORT_EMAIL_RELAY_ONLY=true
REPORT_EMAIL_RELAY_TIMEOUT_MS=10000

# Relay destination and auth used between Supabase edge functions and proxy relay
PROXY_SERVER_URL=https://freedomcamp-manager-production.up.railway.app
PROXY_SECRET=change_this_proxy_secret

# Optional convenience aliases consumed by existing workflows
NZSCV_PROXY_SECRET=change_this_proxy_secret
PROXY_SERVER_SECRET=change_this_proxy_secret

# Target repo for GitHub secret writes
GH_REPO=DonSquires/FreedomCamp-Manager

# Supabase target for secret writes
SUPABASE_PROJECT_REF=kxwjcupuxnnbnzcgmkoi
