# OpenAI-compatible AI credentials
# These are used by: analyze-vehicle-photo, get-weather, onspace-ai-chat,
# process-credential-document, process-homeless-data, process-investigation-document,
# import-data, import-historical-data, select-best-vehicle-photo
#
# OPENAI_API_KEY
#   Where to get it:
#     • OpenAI (recommended):  https://platform.openai.com/api-keys
#       Sign in → Dashboard → API keys → "Create new secret key"
#     • Alternative provider:  Any OpenAI-compatible provider (Azure OpenAI,
#       Groq, Together AI, etc.) will issue you an API key on signup.
#
# OPENAI_BASE_URL
#   Leave blank (or omit) to use the default OpenAI endpoint.
#   Set this only if you are using an alternative provider:
#     • OpenAI default:        https://api.openai.com/v1   (no need to set)
#     • Azure OpenAI:          https://<resource>.openai.azure.com/openai/deployments/<deployment>
#     • Groq:                  https://api.groq.com/openai/v1
#     • Together AI:           https://api.together.xyz/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=

