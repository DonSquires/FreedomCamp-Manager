# ============================================================================
# Local Edge Functions Environment
# DO NOT COMMIT THIS FILE - Contains sensitive credentials
# ============================================================================

# --- ALPR (Snapshot Cloud) ---
PLATE_RECOGNIZER_TOKEN=YOUR-PR-TOKEN-HERE
ALPR_CLOUD_URL=https://api.platerecognizer.com/v1/plate-reader/
ALPR_REGIONS=nz
ALPR_MMC=false
ALPR_CONFIG={"mode":"fast"}
ALPR_TIMEOUT_MS=15000
ALPR_CONF_THRESHOLD=0.78

# --- ORC Fallback (Railway Inference Service) ---
INFERENCE_SERVICE_URL=https://orc-ai-inference-service-production.up.railway.app

# --- Supabase (Database & Storage) ---
# NOTE: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected
# by Supabase in both local and hosted environments. Do not set manually.
