# PTT Signaling Server Configuration
PORT=3002
NODE_ENV=production

# Proxy secret for authenticating requests from Supabase Edge Functions
PTT_PROXY_SECRET=your-proxy-secret-here

# JWT secret for signing/verifying channel tokens (should match Supabase Edge Function secret)
PTT_JWT_SECRET=your-jwt-secret-here

# Radio SFU (Phase 1 Group B — mediasoup)
# Secret used by the Supabase radio-token Edge Function to call /radio/token
RADIO_PROXY_SECRET=your-radio-proxy-secret-here
# JWT secret for signing radio session tokens (can be same as PTT_JWT_SECRET)
RADIO_JWT_SECRET=your-radio-jwt-secret-here
# Public IP announced to WebRTC clients for ICE candidates
ANNOUNCED_IP=your-server-public-ip
# mediasoup RTP port range (must be open in firewall)
SFU_MIN_PORT=40000
SFU_MAX_PORT=49999
# Number of mediasoup workers (defaults to 1, max = CPU count)
SFU_WORKER_COUNT=1

# TURN server (required for restrictive networks)
TURN_URL=turn:your-turn-server:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-credential
STUN_URL=stun:stun.l.google.com:19302

# Optional: Audio clip settings
MAX_CLIP_DURATION_SECONDS=30
MAX_CLIP_SIZE_BYTES=1572864

# Optional: Channel limits
MAX_PARTICIPANTS_PER_CHANNEL=50

# Optional: stale mint tracker cleanup retention window in milliseconds
# PTT_TOKEN_TRACKER_RETENTION_MS=300000

# Optional: regex pattern for allowed preview hostnames under onspace.build
# Default: ^preview-[a-z0-9-]+\.onspace\.build$
# PTT_ALLOWED_PREVIEW_ORIGIN_REGEX=^preview-[a-z0-9-]+\.onspace\.build$

# Optional: TURN server configuration (for NAT traversal)
# TURN_URL=turn:turn.fcmanager.co.nz:3478,turns:turn.fcmanager.co.nz:443?transport=tcp
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential

# Optional: Redis-backed persistence for channel metadata and emergency state.
# Leave unset to keep the current in-memory-only behavior.
# REDIS_URL=redis://127.0.0.1:6379
# RADIO_SPEECH_QUEUE_KEY=radio:speech:events
# RADIO_SPEECH_DLQ_KEY=radio:speech:events:dlq
# RADIO_SPEECH_WEBHOOK_URL=http://inference-service:3000/radio/speech-event
# RADIO_SPEECH_WEBHOOK_SECRET=replace-with-shared-secret
# RADIO_SPEECH_INFERENCE_API_KEY=match-inference-service-api-key-or-service-role
# RADIO_SPEECH_WEBHOOK_TIMEOUT_MS=10000
# RADIO_SPEECH_MAX_ATTEMPTS=4
# RADIO_SPEECH_BACKOFF_BASE_MS=1000
# RADIO_SPEECH_BACKOFF_MAX_MS=10000
# RADIO_SPEECH_POP_TIMEOUT_SECONDS=5
# PTT_REDIS_CHANNEL_META_TTL_SECONDS=86400
# PTT_REDIS_EMERGENCY_TTL_SECONDS=86400

# Optional: enforce relay-only policy (recommended for mission-critical cross-network audio)
# FORCE_TURN_RELAY=true

# Optional: disable public STUN (required for strict self-hosted transport posture)
# If true and FORCE_TURN_RELAY=false, server will derive stun: URLs from TURN_URL.
# PTT_DISABLE_PUBLIC_STUN=true
