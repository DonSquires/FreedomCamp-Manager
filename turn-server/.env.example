# Self-hosted TURN server configuration
# Set strong secrets before production use.

TURN_REALM=fcmanager.co.nz
TURN_USERNAME=ptt_turn_user
TURN_PASSWORD=replace-with-strong-random-secret

TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# When TURN runs behind NAT, set public_ip/private_ip (example: 203.0.113.10/10.0.0.5)
# TURN_EXTERNAL_IP=
TURN_LISTEN_IP=0.0.0.0

# TLS/DTLS support (optional but recommended)
TURN_ENABLE_TLS=false
TURN_TLS_PORT=5349
# TURN_CERT_FILE=/etc/coturn/certs/fullchain.pem
# TURN_KEY_FILE=/etc/coturn/certs/privkey.pem

# Set true only if hosting platform cannot expose UDP
TURN_NO_UDP=false
