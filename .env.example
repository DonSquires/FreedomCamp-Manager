# Web Admin Portal — Environment Variables
#
# Copy this file to .env and fill in your Supabase project values:
#
#   cp .env.example .env
#
# Then edit .env and replace the placeholder values below.
#
# Where to find these values:
#   VITE_SUPABASE_URL      → Supabase Dashboard → Settings → API → Project URL
#   VITE_SUPABASE_ANON_KEY → Supabase Dashboard → Settings → API → anon / public key

# The URL of your Supabase project instance.
VITE_SUPABASE_URL=https://YOUR_REF.supabase.co

# The public anonymous key for your Supabase project, safe for client-side use.
VITE_SUPABASE_ANON_KEY=eyJhbGci...YOUR_ANON_KEY
