# Web Admin Portal — Environment Variables
#
# ── CODESPACE QUICKSTART ──────────────────────────────────────────────────────
# This file is automatically copied to .env when your Codespace is created.
# You only need to fill in VITE_SUPABASE_ANON_KEY to connect to the backend.
#
# Recommended: set VITE_SUPABASE_ANON_KEY as a GitHub Codespace Secret at
#   https://github.com/settings/codespaces
# so it is injected automatically for every new Codespace you create.
#
# ── OTHER ENVIRONMENTS ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your Supabase project values:
#
#   cp .env.example .env
#
# Then edit .env and replace the placeholder values below.
#
# Where to find these values:
#   VITE_SUPABASE_URL      → Supabase Dashboard → Settings → API → Project URL
#   VITE_SUPABASE_ANON_KEY → Supabase Dashboard → Settings → API → anon / public key

# The URL of your Supabase project instance.
VITE_SUPABASE_URL=https://kxwjcupuxnnbnzcgmkoi.supabase.co

# The public anonymous key for your Supabase project, safe for client-side use.
# ⚠️  REQUIRED — the app will show "Setup Required" until this is set.
VITE_SUPABASE_ANON_KEY=eyJhbGci...YOUR_ANON_KEY

# ── Google Maps Geocoding API (optional but recommended) ─────────────────────
#
# Used for reverse-geocoding GPS coordinates to street addresses in:
#   - ScanDetailPanel (location display during officer scans)
#   - Zone management (auto-naming zones from GPS)
#
# Without this key the app falls back to Nominatim (OpenStreetMap), which
# is free but rate-limited to 1 request/second and may be slower.
#
# How to get a key:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project → Enable "Geocoding API"
#   3. Create credentials → API key
#   4. Restrict the key to your domain (recommended)
#   5. Paste the key below
#
# Billing note: Google provides $200/month free credit (~40,000 geocodes).
#
VITE_GOOGLE_MAPS_API_KEY=

# ── Railway Services (optional — only needed if using Railway-hosted backends) ─
#
# These are the public-facing URLs for the Railway-deployed backend services.
# They are loaded by src/lib/railway.ts for health checks and direct calls from
# the browser during development/testing.  In production, the Edge Functions use
# the equivalent INFERENCE_SERVICE_URL and PROXY_SERVER_URL secrets set in the
# Supabase Dashboard (not these VITE_ env vars).
#
# VITE_PROXY_SERVER_URL:      Your Railway NZSCV proxy URL
#                             (e.g. https://nzscv-proxy-production.up.railway.app)
# VITE_INFERENCE_SERVICE_URL: Bob inference endpoint URL
#                             RunPod serverless example: https://api.runpod.ai/v2/<RUNPOD_ENDPOINT_ID>
#                             (this repo uses /runsync on top of that base URL)
# VITE_PTT_SERVER_URL:        PTT signaling server WebSocket URL
#                             Production path: wss://ptt.<your-domain>/ws
#                             Used for Push-to-Talk (PTT) feature in Field Officer Portal.
#
VITE_PROXY_SERVER_URL=
VITE_INFERENCE_SERVICE_URL=https://api.runpod.ai/v2/<RUNPOD_ENDPOINT_ID>
VITE_PTT_SERVER_URL=wss://ptt.<your-domain>/ws
VITE_BOB_TRANSLATOR_WS_URL=wss://<your-runpod-pod>/ws/translate

# ── Playwright E2E Credentials (local + Codespaces normalization) ───────────
# Canonical role variables consumed by tests/e2e/auth.ts. Legacy aliases
# PLAYWRIGHT_ADMIN_EMAIL and PLAYWRIGHT_OFFICER_EMAIL are still accepted and
# auto-mapped by scripts/playwright-codespace-credentials.sh.
#
# GitHub/Codespaces secret mapping:
#   TEST_MASTER_*           -> PLAYWRIGHT_MASTER_*
#   TEST_ADMIN_*            -> PLAYWRIGHT_ADMIN_ORG1_*
#   TEST_OFFICER_*          -> PLAYWRIGHT_OFFICER_ORG1_*
#   TEST_CLIENT_*           -> PLAYWRIGHT_CLIENT_VIEWER_*
#   TEST_CLIENT_OFFICER_*   -> PLAYWRIGHT_CLIENT_STAFF_*

PLAYWRIGHT_MASTER_EMAIL=
PLAYWRIGHT_MASTER_PASSWORD=
PLAYWRIGHT_ADMIN_ORG1_EMAIL=
PLAYWRIGHT_ADMIN_ORG1_PASSWORD=
PLAYWRIGHT_ADMIN_ORG2_EMAIL=
PLAYWRIGHT_ADMIN_ORG2_PASSWORD=
PLAYWRIGHT_OFFICER_ORG1_EMAIL=
PLAYWRIGHT_OFFICER_ORG1_PASSWORD=
PLAYWRIGHT_OFFICER_ORG2_EMAIL=
PLAYWRIGHT_OFFICER_ORG2_PASSWORD=
PLAYWRIGHT_CLIENT_VIEWER_EMAIL=
PLAYWRIGHT_CLIENT_VIEWER_PASSWORD=
PLAYWRIGHT_CLIENT_STAFF_EMAIL=
PLAYWRIGHT_CLIENT_STAFF_PASSWORD=
PLAYWRIGHT_ALLOW_SHARED_CREDENTIAL_FALLBACK=1

# Optional Playwright-prefixed Supabase aliases used by some test cleanup paths.
PLAYWRIGHT_SUPABASE_URL=
PLAYWRIGHT_SUPABASE_ANON_KEY=
PLAYWRIGHT_SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Edge Function secrets (set in Supabase Dashboard, NOT here) ─────
#
# The following values are consumed by Edge Functions at runtime.
# Set them in Supabase Dashboard → Project → Edge Functions → Secrets
# (or via `supabase secrets set KEY=VALUE --project-ref YOUR_REF`).
# They are listed here only for documentation/reference.
#
# DISPUTE_RATE_LIMIT_PER_10MIN  — Max dispute submissions per IP per 10 minutes
#                                 (default: 3 if not set).  Set in Supabase secrets.
# DISPUTE_ACK_EMAIL_FROM        — From address for dispute acknowledgment emails
#                                 (e.g. noreply@fcmanager.co.nz).  Set in Supabase secrets.
# INFERENCE_SERVICE_URL         — Internal URL for the Railway inference service,
#                                 used by Edge Functions (not exposed to browser).
# PROXY_SERVER_URL              — Internal URL for the Railway NZSCV proxy,
#                                 used by Edge Functions (not exposed to browser).
# PTT_SERVER_URL                — HTTPS URL for the PTT signaling server
#                                 used by Edge Functions (not exposed to browser).
# PTT_JWT_SECRET                — Secret used to sign PTT channel access tokens.
# BOB_RUNPOD_RETRIES            — Retry count for RunPod /runsync chat calls (default: 2).
# BOB_RUNPOD_BACKOFF_MS         — Initial backoff in ms for RunPod retries (default: 700).
# BOB_RUNPOD_MAX_BACKOFF_MS     — Max backoff cap in ms for RunPod retries (default: 5000).
# BOB_RUNPOD_TIMEOUT_MS         — Per-attempt timeout in ms for RunPod calls (default: 90000).
# BOB_INFERENCE_CHAT_RETRIES    — Retry count for standard inference /chat calls (default: 2).
# BOB_INFERENCE_CHAT_BACKOFF_MS — Initial backoff in ms for /chat retries (default: 500).
# BOB_INFERENCE_CHAT_MAX_BACKOFF_MS — Max backoff cap in ms for /chat retries (default: 4000).
# BOB_INFERENCE_CHAT_TIMEOUT_MS — Per-attempt timeout in ms for /chat calls (default: 60000).
# BOB_OLLAMA_CHAT_RETRIES       — Retry count for Ollama /api/chat fallback calls (default: 2).
# BOB_OLLAMA_CHAT_BACKOFF_MS    — Initial backoff in ms for Ollama retries (default: 500).
# BOB_OLLAMA_CHAT_MAX_BACKOFF_MS — Max backoff cap in ms for Ollama retries (default: 4000).
# BOB_OLLAMA_CHAT_TIMEOUT_MS    — Per-attempt timeout in ms for Ollama calls (default: 60000).
# BOB_SUPERVISOR_INTERVAL_MS    — Supervisor loop interval in ms (default: 60000).
# BOB_SUPERVISOR_FAILURE_THRESHOLD — Consecutive failures before recovery hooks run (default: 3).
# BOB_SUPERVISOR_SMOKE_TIMEOUT_MS — Timeout in ms for the supervisor smoke ping (default: 45000).
# BOB_SUPERVISOR_ACTION_COOLDOWN_MS — Cooldown in ms between recovery/scale actions (default: 300000).
# BOB_SUPERVISOR_SCALE_DOWN_IDLE_MS — Idle threshold in ms before scale-down hook runs (default: 1800000).
# BOB_SUPERVISOR_STATE_FILE     — State file path for supervisor persistence (default: .runtime/runpod-bob-supervisor-state.json).
# BOB_SUPERVISOR_ACTIVITY_FILE  — Activity heartbeat file path (default: .runtime/runpod-bob-activity.touch).
# BOB_SUPERVISOR_PING_MESSAGE   — Smoke-test chat message for supervisor pings (default: ping).
# BOB_RUNPOD_RECOVER_CMD        — Optional shell command for recovery after repeated failures.
# BOB_RUNPOD_SCALE_UP_CMD       — Optional shell command to scale up after repeated failures.
# BOB_RUNPOD_SCALE_DOWN_CMD     — Optional shell command to scale down after inactivity.
# BOB_AUTOMATION_WEBHOOK_TOKEN  — Bearer token for runpod-bob-hook-server (required for that server).
# BOB_AUTOMATION_WEBHOOK_HOST   — Hook server host bind (default: 127.0.0.1).
# BOB_AUTOMATION_WEBHOOK_PORT   — Hook server port (default: 8787).
#
# ── Bob provider lock (required by bobInfer.ts in Supabase Edge Functions) ───
# BOB_ALLOWED_INFERENCE_HOSTS  — Comma-separated allowed outbound inference origins.
#                                 Must be set when BOB_PROVIDER_LOCK_DISABLED is not true.
#                                 Example: https://api.runpod.ai,https://your-railway-service.up.railway.app
# BOB_PROVIDER_LOCK_DISABLED   — Set to "true" to bypass the provider allowlist check.
#
# ── RunPod endpoint (used by scripts and conductor) ──────────────────────────
# RUNPOD_ENDPOINT_ID            — Serverless endpoint ID (e.g. n0bp1ifmq01cx2)
# RUNPOD_API_URL                — Full RunPod base URL: https://api.runpod.ai/v2/<RUNPOD_ENDPOINT_ID>

# ── Web Push / VAPID ──────────────────────────────────────────────────────────
# Generate a key pair once with: node scripts/generate-vapid-keys.js
# Then add the public key here and the private key + subject to Supabase secrets.
#
# Supabase Edge Function secrets required:
#   VAPID_PUBLIC_KEY   — same value as VITE_VAPID_PUBLIC_KEY below
#   VAPID_PRIVATE_KEY  — private scalar (never expose to browser)
#   VAPID_SUBJECT      — mailto: or https: contact URI (e.g. mailto:admin@fcmanager.co.nz)
#
# Pre-generated pair (generated via `node scripts/generate-vapid-keys.js`):
VITE_VAPID_PUBLIC_KEY=BIY21DxwTAAAyZ87D8R1Vq44FPEXXsh4oMYUfIFfraWMoED1nH--CIZqcK4erRseEX1MzaRiXy02x9mheQAmpts

# ── Cloudflare Turnstile (CAPTCHA) ───────────────────────────────────────────
# Public-facing site key for the Turnstile widget rendered in the browser.
# Required on public endpoints (dispute intake, case lookup) in production.
# The corresponding secret key goes into Supabase Edge Function secrets as
# TURNSTILE_SECRET_KEY (never expose the secret key here or in any client code).
#
# How to get it:
#   Cloudflare Dashboard → Turnstile → Add Widget → copy "Site Key"
#
VITE_TURNSTILE_SITE_KEY=

# ── App Metadata ──────────────────────────────────────────────────────────────
# Displayed in the UI and included in bug/feedback reports.
# Defaults to "dev" if not set — override in CI/CD for production builds.
VITE_APP_VERSION=1.0.0

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Enable the clean-rebuild router/page set (not needed in standard deployments).
VITE_ENABLE_CLEAN_REBUILD_ROUTES=false

# ── Radio / PTT Phase Flags ───────────────────────────────────────────────────
# All default to false. Enable per-phase in staging before production rollout.
# Phase 1: route PTT audio through mediasoup SFU instead of peer-to-peer.
VITE_RADIO_SFU_ENABLED=false
# Phase 2: display live STT caption panel in the radio console.
VITE_RADIO_CAPTIONS_ENABLED=false
# Phase 3: show translation controls and translated caption output.
VITE_RADIO_TRANSLATION_ENABLED=false
# Phase 4/5: badge synthetic / TTS-rendered audio in the transmission log.
VITE_RADIO_SYNTHETIC_AUDIO_ENABLED=false
