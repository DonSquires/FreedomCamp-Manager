RAILWAY_PROXY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_PRODUCTION_ENVIRONMENT_ID=
RAILWAY_PROXY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_BACKEND_SERVICE_ID=
RAILWAY_PROXY_SERVICE_ID=
RAILWAY_INFERENCE_SERVICE_ID=
RAILWAY_PTT_SERVICE_ID=
RAILWAY_BOB_TOKEN=
RAILWAY_BOB_SERVICE_ID=
RAILWAY_BOB_PROJECT_ID=
RAILWAY_OLLAMA_SERVICE_ID=

# RunPod / Bob / inference coordination.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_ENDPOINT_URL=
RUNPOD_ENDPOINT_API_KEY=
RUNPOD_SERVERLESS_URL=
RUNPOD_RUNSYNC_URL=
RUNPOD_GATEWAY_URL=
BOB_SERVICE_URL=
BOB_INFERENCE_API_KEY=
INFERENCE_API_KEY=

# Proxy / PTT / TURN / email service endpoints used across browser, Supabase,
# Railway, and mobile clients. Keep the browser-facing VITE_ vars and server-
# side secret vars pointed at the same deployment targets.
# If business email is managed in hPanel/Hostinger mailboxes, keep Postal vars
# blank unless a Postal API server is intentionally deployed.
# MotorWeb vars should remain unset until onboarding provides API credentials.
VITE_PROXY_SERVER_URL=
VITE_INFERENCE_SERVICE_URL=https://api.runpod.ai/v2/n0bp1ifmq01cx2
VITE_PTT_SERVER_URL=wss://fieldops-railway-stt-production.up.railway.app/ws
VITE_WHISPER_PROXY_URL=https://fieldops-railway-stt-production.up.railway.app
VITE_BOB_MANAGER_URL=https://fieldops-backend-production.up.railway.app
PROXY_SERVER_URL=
PTT_SERVER_URL=https://ptt.fcmanager.co.nz
PTT_WS_URL=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_REPORTS_FROM_EMAIL=
SMTP_REPORTS_FROM_NAME=
# Deprecated (SMTP-only stack): keep blank unless Postal is reintroduced.
POSTAL_API_URL=
POSTAL_API_KEY=

