# FieldOps Officer — Mobile App Environment
# Copy this to .env and fill in your values

# Your Supabase project URL (same as the web app)
EXPO_PUBLIC_SUPABASE_URL=https://kxwjcupuxnnbnzcgmkoi.supabase.co

# Your Supabase anonymous (public) key
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...YOUR_ANON_KEY

# Browser-facing service aliases used by the mobile/web stack
EXPO_PUBLIC_PTT_SERVER_URL=wss://fieldops-railway-stt-production.up.railway.app/ws
VITE_PROXY_SERVER_URL=
VITE_INFERENCE_SERVICE_URL=https://api.runpod.ai/v2/n0bp1ifmq01cx2
VITE_PTT_SERVER_URL=wss://fieldops-railway-stt-production.up.railway.app/ws
VITE_WHISPER_PROXY_URL=https://fieldops-railway-stt-production.up.railway.app
VITE_BOB_MANAGER_URL=https://fieldops-backend-production.up.railway.app
VITE_TURNSTILE_SITE_KEY=

# Primary Bob Assistant inference endpoint (set as Supabase INFERENCE_SERVICE_URL secret)
INFERENCE_SERVICE_URL=https://api.runpod.ai/v2/n0bp1ifmq01cx2
