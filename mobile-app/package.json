{
  "name": "fieldops-manager",
  "version": "1.0.0",
  "packageManager": "npm@10.8.2",
  "main": "./App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web:export": "expo export --platform web",
    "deploy": "npm run web:export && eas deploy",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "eas-build-pre-install": "node ./scripts/enforce-build-origin.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.56.2",
    "expo": "~51.0.28",
    "expo-av": "~14.0.7",
    "expo-camera": "~15.0.16",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.9",
    "expo-image-picker": "~15.1.0",
    "expo-location": "~17.0.1",
    "expo-notifications": "~0.28.18",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "expo-updates": "~0.25.27",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.19.13",
    "sonner-native": "^0.16.1",
    "zustand": "^5.0.0",
    "react-native-android-auto": "^1.0.0"
  },
  "overrides": {
    "sonner-native": {
      "react-native-svg": "15.2.0"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-svg"
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.45",
    "typescript": "~5.3.3"
  }
}
