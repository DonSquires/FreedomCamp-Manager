{
  "name": "Bob-Development-Env",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",

  // -----------------------------------------------------------------------
  // Extra tools installed at container build time.
  // All of these are available the moment you open the Codespace in your
  // browser — no local installs required.
  // -----------------------------------------------------------------------
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" },
    "ghcr.io/devcontainers/features/docker-in-docker:1": {},
    "ghcr.io/devcontainers-contrib/features/bun:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-contrib/features/supabase-cli:1": { "version": "2.78.1" },
    "ghcr.io/devcontainers-contrib/features/deno:1": {}
  },

  // -----------------------------------------------------------------------
  // VS Code extensions that will be auto-installed in the Codespace.
  // -----------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "denoland.vscode-deno",
        "github.copilot",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },

  // -----------------------------------------------------------------------
  // Run once after the container is created.
  // This script bootstraps the full Bob environment:
  // - local app dependencies
  // - Ollama runtime
  // - ONNX Runtime + RunPod Python SDK
  // - optional model pulls if URLs are provided via secrets/env vars
  // -----------------------------------------------------------------------
  "onCreateCommand": "cp -n .env.example .env 2>/dev/null || true",
  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  // -----------------------------------------------------------------------
  // Run every time the Codespace starts (after create).
  // Starts the Vite dev server so the app is immediately accessible via
  // the forwarded port preview tab.
  // Dev server logs are written to ~/vite-dev.log — run `tail -f ~/vite-dev.log`
  // in the terminal if you need to diagnose startup issues.
  // -----------------------------------------------------------------------
  "postStartCommand": "bash .devcontainer/postStart.sh",

  // Forward the Vite dev server port so you can preview the app in your
  // browser tab directly from Codespaces.
  "forwardPorts": [5173, 3000, 3002, 8080, 11434],

  "portsAttributes": {
    "5173": { "label": "Vite Dev Server", "onAutoForward": "openPreview" },
    "3000": { "label": "Proxy Server" },
    "3002": { "label": "PTT Signaling Server" },
    "8080": { "label": "Inference Service" }
  },

  "remoteEnv": {
    "RUNPOD_API_KEY": "${localEnv:RUNPOD_API_KEY}",
    "RUNPOD_POD_ID": "${localEnv:RUNPOD_POD_ID}",
    "BOB_VEHICLE_MODEL_URL": "${localEnv:BOB_VEHICLE_MODEL_URL}",
    "BOB_FACE_MODEL_URL": "${localEnv:BOB_FACE_MODEL_URL}",
    "BOB_SMOKE_MODEL_URL": "${localEnv:BOB_SMOKE_MODEL_URL}"
  },

  "remoteUser": "vscode"
}
