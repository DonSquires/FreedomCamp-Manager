# Copy to a local file (for example: .env.actions.local), fill values,
# then run:
#   GH_TOKEN=<token-with-repo-admin> ./scripts/set-actions-secrets.sh --repo DonSquires/FreedomCamp-Manager --file .env.actions.local
#
# Note: You only provide canonical names in this file.
# The script also writes compatibility aliases (for example SUPABASE_URL,
# RAILWAY_CORE_TOKEN, BOB_INFERENCE_API_KEY) when their canonical source exists.

# Required: Railway deploy
RAILWAY_BOB_TOKEN=
RAILWAY_BOB_SERVICE_ID=
RAILWAY_OLLAMA_SERVICE_ID=
RAILWAY_TOKEN=
RAILWAY_PROXY_SERVICE_ID=

# Optional but recommended (service auto-resolution / legacy deploy)
RAILWAY_BOB_PROJECT_ID=
RAILWAY_INFERENCE_SERVICE_ID=

# Required: Supabase + app
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
INFERENCE_API_KEY=

# Required: frontend deploy
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Required: Bob sync
BOB_SYNC_PAT=

# Optional URLs / monitoring / tests
BOB_SERVICE_URL=
INFERENCE_SERVICE_URL=
PROXY_SERVER_URL=
PTT_SERVER_URL=
OLLAMA_SERVICE_URL=
FRONTEND_URL=
SYNTHETIC_MONITOR_USER_ID=

# Optional Bob ops workflows
BOB_FEEDBACK_SYNC_URL=
BOB_FEEDBACK_SYNC_KEY=

# Optional intel sync workflows
INTEL_FEED_URLS=
INTEL_HMAC_KEY=
INTEL_INGEST_URL=
INTEL_ALLOWED_HOSTS=
INTEL_REGION_ORG_MAP=
INTEL_ENABLE_DB_SYNC=

# Optional maps import
STATSNZ_API_KEY=

# Optional mobile deploy
EXPO_TOKEN=
EXPO_PROJECT_ID=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Optional frontend environment-specific deploy
VITE_SUPABASE_URL_PRODUCTION=
VITE_SUPABASE_ANON_KEY_PRODUCTION=
VITE_INFERENCE_SERVICE_URL_PRODUCTION=
VITE_PROXY_SERVER_URL_PRODUCTION=
VITE_SUPABASE_URL_PREVIEW=
VITE_SUPABASE_ANON_KEY_PREVIEW=
VITE_INFERENCE_SERVICE_URL_PREVIEW=
VITE_PROXY_SERVER_URL_PREVIEW=

# Optional PTT setup workflow
PTT_PROXY_SECRET=

# Optional API gate credentials
API_TEST_BEARER_TOKEN=
API_TEST_EMAIL=
API_TEST_PASSWORD=

# Optional Playwright role credentials (canonical names)
PLAYWRIGHT_MASTER_EMAIL=
PLAYWRIGHT_MASTER_PASSWORD=
PLAYWRIGHT_ADMIN_ORG1_EMAIL=
PLAYWRIGHT_ADMIN_ORG1_PASSWORD=
PLAYWRIGHT_ADMIN_ORG2_EMAIL=
PLAYWRIGHT_ADMIN_ORG2_PASSWORD=
PLAYWRIGHT_OFFICER_ORG1_EMAIL=
PLAYWRIGHT_OFFICER_ORG1_PASSWORD=
PLAYWRIGHT_OFFICER_ORG2_EMAIL=
PLAYWRIGHT_OFFICER_ORG2_PASSWORD=
PLAYWRIGHT_CLIENT_VIEWER_EMAIL=
PLAYWRIGHT_CLIENT_VIEWER_PASSWORD=
PLAYWRIGHT_CLIENT_STAFF_EMAIL=
PLAYWRIGHT_CLIENT_STAFF_PASSWORD=
PLAYWRIGHT_SUPABASE_SERVICE_ROLE_KEY=
