# NZSCV API Credentials (provided by PGDB after application approval)
NZSCV_API_KEY=your_nzscv_api_authorization_here
NZSCV_ID_KEY=your_nzscv_api_identifier_here

# NZSCV Endpoint URL — set this to the full endpoint URL for the environment you are targeting.
# Test environment:        https://tst.nzscv.co.nz/rest/info/v1/vehicleregistrationinfo
# Production environment:  https://www.nzscv.co.nz/api/rest/scv/v1/vehicleregistrationinfo
# If NZSCV_ENDPOINT_URL is not set, NZSCV_BASE_URL + the default production path is used.
NZSCV_ENDPOINT_URL=https://tst.nzscv.co.nz/rest/info/v1/vehicleregistrationinfo

# Legacy base URL fallback (only used when NZSCV_ENDPOINT_URL is not set)
# NZSCV_BASE_URL=https://www.nzscv.co.nz

# MotorWeb API Credentials (for vehicle enrichment)
MOTORWEB_API_KEY=your_motorweb_api_key_here
MOTORWEB_ID_KEY=your_motorweb_id_key_here

# MotorWeb Environment
MOTORWEB_BASE_URL=https://robot.motorweb.co.nz

# Proxy Authentication Secret (generate a random string)
# This prevents unauthorized access to your proxy
PROXY_SECRET=your_random_secret_here_change_this

# Server Port (DigitalOcean/Railway will auto-set this)
PORT=3000

# Environment
NODE_ENV=production
