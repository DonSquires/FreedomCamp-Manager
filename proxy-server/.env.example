# NZSCV API Credentials (provided by PGDB after application approval)
# IMPORTANT: These are the TEST environment credentials.
# The NZSCV_API_KEY value is the PGDB-Authorization header.
# The NZSCV_ID_KEY value is the PGDB-Identifier header.
# For production: contact NZSCV/PGDB to get production credentials and whitelist your proxy IP.
NZSCV_API_KEY=your_nzscv_api_authorization_here
NZSCV_ID_KEY=your_nzscv_api_identifier_here

# NZSCV Endpoint URL — set this to the full endpoint URL for the environment you are targeting.
# Test environment:        https://tst.nzscv.co.nz/rest/info/v1/vehicleregistrationinfo
# Production environment:  https://www.nzscv.co.nz/api/rest/scv/v1/vehicleregistrationinfo
# IMPORTANT: The IP address of this proxy server must be whitelisted by NZSCV/PGDB.
# The same proxy IP used for test must also be whitelisted for production.
NZSCV_ENDPOINT_URL=https://tst.nzscv.co.nz/rest/info/v1/vehicleregistrationinfo

# Legacy base URL fallback (only used when NZSCV_ENDPOINT_URL is not set)
# NZSCV_BASE_URL=https://www.nzscv.co.nz

# MotorWeb API Credentials (for vehicle enrichment)
MOTORWEB_API_KEY=your_motorweb_api_key_here
MOTORWEB_ID_KEY=your_motorweb_id_key_here

# MotorWeb Environment
MOTORWEB_BASE_URL=https://robot.motorweb.co.nz

# Proxy Authentication Secret (generate a random string)
# This prevents unauthorized access to your proxy
PROXY_SECRET=your_random_secret_here_change_this

# Server Port (DigitalOcean/Railway will auto-set this)
PORT=3000

# Environment
NODE_ENV=production

# Invite Email SMTP (used by /api/email/send-invite)
# Zoho recommended: SMTP_HOST=smtp.zoho.com, SMTP_PORT=465, SMTP_USERNAME=full mailbox email
# IMPORTANT: SMTP_FROM_EMAIL should match SMTP_USERNAME to avoid relay rejection.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USERNAME=you@yourdomain.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=you@yourdomain.com
SMTP_FROM_NAME=FieldOps Manager
SITE_URL=https://fcmanager.co.nz

# ── Public Dispute Flow ─────────────────────────────────────────────────────
# Supabase — used by /api/disputes/* to look up infringement notices and write
# dispute_submissions records.  Never exposed to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Runpod — serverless AI worker for OCR / NLP evidence analysis.
# Leave blank to skip AI analysis (non-fatal).
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_runpod_serverless_endpoint_id_here

# Postal — self-hosted mail server for dispute confirmation emails.
# POSTAL_API_URL should be the base URL of your Postal installation
# (e.g. https://mail.fcmanager.co.nz).  Leave blank to skip emails (non-fatal).
POSTAL_API_URL=https://mail.fcmanager.co.nz
POSTAL_API_KEY=your_postal_server_api_key_here
