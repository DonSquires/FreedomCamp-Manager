{
  "stages": {
    "secretAlignmentChecks": true,
    "externalServiceChecks": true,
    "multimodalChecks": true,
    "uiChecks": true
  },
  "timeouts": {
    "documentPollAttempts": 8,
    "documentPollIntervalMs": 2000
