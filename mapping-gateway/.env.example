PORT=3000
MAPPING_GATEWAY_TIMEOUT_MS=15000

# Tile proxy templates served by the mapping gateway container.
# Use internal or self-hosted tile sources here.
MAPPING_GATEWAY_STREET_TILE_URL=https://tiles.example.internal/street/{z}/{x}/{y}.png
MAPPING_GATEWAY_STREET_TILE_ATTRIBUTION=&copy; OnSpace AI in-house mapping
MAPPING_GATEWAY_FALLBACK_TILE_URL=
MAPPING_GATEWAY_FALLBACK_TILE_ATTRIBUTION=
MAPPING_GATEWAY_SATELLITE_TILE_URL=https://tiles.example.internal/satellite/{z}/{x}/{y}.jpg
MAPPING_GATEWAY_SATELLITE_TILE_ATTRIBUTION=&copy; OnSpace AI in-house satellite mapping

# Optional routing support
GOOGLE_SUPPORT_ENABLED=false
GOOGLE_MAPS_API_KEY=
GOOGLE_API_KEY=
OSRM_BACKEND_URL=
VALHALLA_BACKEND_URL=