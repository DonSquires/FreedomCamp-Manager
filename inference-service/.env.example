# Inference Service Configuration

# Server
PORT=3000
NODE_ENV=production

# Security — comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://xbfnlzmpumthnjmtqufp.supabase.co

# Model paths (defaults shown — override if models are elsewhere)
YOLO_MODEL_PATH=./models/yolov8n.onnx
EMBEDDING_MODEL_PATH=./models/mobilenet_v3.onnx

# Vehicle detection confidence threshold (0.0–1.0)
DETECTION_CONFIDENCE=0.5

# OpenAI Vision — OPTIONAL (Railway service only)
# When set, each /infer call uses gpt-4o-mini to extract:
#   plate number, vehicle make/model/colour, self-contained flag
# NOTE: Plate Recognizer API (set in Supabase secrets) is the PRIMARY
# plate recognition source — OpenAI Vision on Railway is only a backup
# for the embedding pipeline when Plate Recognizer is not configured.
OPENAI_API_KEY=

# Performance
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
REQUEST_TIMEOUT=30000     # 30 seconds

# Monitoring (optional)
SENTRY_DSN=
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# PLATE RECOGNIZER — set in Supabase Edge Function Secrets (not here)
# ─────────────────────────────────────────────────────────────────────────────
# The Plate Recognizer API token belongs in Supabase secrets, not in this file.
# This service does NOT call Plate Recognizer; the orc-ingest Edge Function does.
#
# Set it with:
#   supabase secrets set PLATE_RECOGNIZER_TOKEN="your-token-here"
#   supabase secrets set PLATE_RECOGNIZER_API_URL="https://api.platerecognizer.com/v1/plate-reader/"
#
# See QUICKSTART.md for the full secret configuration guide.
