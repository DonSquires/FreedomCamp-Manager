# Inference Service Configuration
# Primary endpoint consumed by Supabase edge functions (set in Supabase vault):
# INFERENCE_SERVICE_URL=https://<your-runpod-pod-url>

# Server
PORT=3000
NODE_ENV=production

# Security
ALLOWED_ORIGINS=https://kxwjcupuxnnbnzcgmkoi.supabase.co

# Temporary operational profile: when Bob/Ollama need external access while
# bringing the stack online or training models, set the three flags below to
# false in Railway and use a full https:// OLLAMA_BASE_URL.
#
# Preferred approach: set BOB_OPERATING_MODE instead of juggling the three
# legacy flags directly.
#   BOB_OPERATING_MODE=self-contained  -> strict local-only posture
#   BOB_OPERATING_MODE=build-training  -> internet-enabled build/training mode
#
# Example external profile:
# BOB_OPERATING_MODE=build-training
# SELF_CONTAINED_MODE=false
# REQUIRE_SELF_CONTAINED_MODE=false
# SELF_CONTAINED_STRICT_EGRESS=false
# OLLAMA_BASE_URL=https://ollama-production-a142.up.railway.app

# Explicit Bob operating profile. If unset, the service derives the mode from
# SELF_CONTAINED_MODE for backward compatibility.
BOB_OPERATING_MODE=build-training

# When true, disables outbound cloud provider calls (OpenAI, Plate Recognizer).
# Local ONNX and local OCR paths remain available.

# Dr Bob health tuning
# - Set false on Alpine/musl hosts where onnxruntime-node is intentionally unavailable.
DOCTOR_REQUIRE_ONNX_MODELS=true
# Increase probe tolerance for slower Ollama hosts.
DOCTOR_OLLAMA_PROBE_TIMEOUT_MS=12000
DOCTOR_OLLAMA_PROBE_RETRIES=2
SELF_CONTAINED_MODE=false

# When true, service will refuse startup unless SELF_CONTAINED_MODE=true.
# Use this for government/high-assurance deployments.
REQUIRE_SELF_CONTAINED_MODE=false

# When true (default), blocks ALL non-local outbound HTTP calls at runtime.
# This includes OpenAI, cloud ALPR, and remote JWKS fetches.
SELF_CONTAINED_STRICT_EGRESS=false

# Model Configuration
YOLO_MODEL_PATH=./models/yolov8n.onnx
EMBEDDING_MODEL_PATH=./models/mobilenet_v3.onnx

# Performance
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
REQUEST_TIMEOUT=30000     # 30 seconds

# Vehicle attribute provider
# - basic  => local dominant-colour estimate only
# - openai or chatgpt => make/model/year/colour + sticker via OpenAI/ChatGPT API
VEHICLE_ATTRS_PROVIDER=basic
ATTR_TIMEOUT_MS=2500

# Tabular NLP provider for CSV/XLSX metadata analysis
# - heuristic => local deterministic analysis (no external providers)
# - ollama    => local LLM via OLLAMA_BASE_URL (falls back to heuristic)
# - openai or chatgpt => ChatGPT/OpenAI-powered analysis
TABULAR_NLP_PROVIDER=heuristic
TABULAR_NLP_TIMEOUT_MS=2500
# Ollama internal URL - Ollama runs co-located on the same RunPod pod as Bob.
# If Ollama is running in a separate container on the same host, use the container name.
# Examples:
#   Same pod (typical RunPod deployment): http://127.0.0.1:11434
#   Separate container:                   http://ollama:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Ollama parallelism (set on the Ollama process, not Bob directly) ---
# These are Ollama environment variables — pass them to the Ollama process in docker-compose.yml
# or the pod's .env. Bob reads OLLAMA_NUM_PARALLEL from its own env to set the HTTP client
# concurrency limit (defaults to 2 if unset).
#
#   Pod size        OLLAMA_NUM_PARALLEL  Notes
#   30 GB           2                   qwen2.5:32b Q4 (~19 GB) + ~11 GB KV headroom
#   80 GB           4                   qwen2.5:72b Q4 (~41 GB) + ~39 GB KV headroom
#   141 GB          8                   qwen2.5:72b Q4 (~41 GB) + ~100 GB KV headroom
#
# OLLAMA_NUM_PARALLEL=2          # concurrent inference slots (set per pod size above)
# OLLAMA_MAX_LOADED_MODELS=2     # keep chat + writing model hot (requires ≥60 GB VRAM)
# OLLAMA_MAX_QUEUE=64            # max queued requests before 503
# OLLAMA_KEEP_ALIVE=24h          # keep model loaded between requests
# OLLAMA_FLASH_ATTENTION=1       # faster attention (supported on Ampere/Ada GPUs)
# Optional workload split (3-Bob architecture):
# - OLLAMA_CHAT_BASE_URL routes /chat to a dedicated high-throughput Ollama pod
# - OLLAMA_PTT_BASE_URL routes translation/PTT language work to a low-latency pod
# - OLLAMA_TABULAR_BASE_URL routes tabular reasoning to a separate pod (defaults to chat upstream)
# OLLAMA_CHAT_BASE_URL=https://chat-gateway.proxy.runpod.net
# OLLAMA_PTT_BASE_URL=https://ptt-gateway.proxy.runpod.net
# OLLAMA_TABULAR_BASE_URL=https://analytics-gateway.proxy.runpod.net

# --- Simple-vs-complex task routing ---
# Set OLLAMA_CHAT_BASE_URL to a dedicated high-throughput Ollama pod for complex chat.
# Chat messages shorter than COMPLEX_CHAT_MIN_LEN chars use OLLAMA_BASE_URL (lightweight).
# Set COMPLEX_CHAT_MIN_LEN=0 to always use the primary endpoint.
# COMPLEX_CHAT_MIN_LEN=300

# --- RunPod pod auto-stop (cost guardrail) ---
# After RUNPOD_IDLE_TIMEOUT_MS ms without a complex task, Bob stops the RunPod pod via API.
# Set both RUNPOD_POD_ID and RUNPOD_API_KEY to enable. Set RUNPOD_IDLE_TIMEOUT_MS=0 to disable.
# RUNPOD_POD_ID=eipnu6bq181q20
# RUNPOD_API_KEY=rpa_xxxxxxxxxxxx
# RUNPOD_IDLE_TIMEOUT_MS=900000    # 15 minutes (default)

# --- RunPod serverless endpoint (event-driven deep verification) ---
# Configure either RUNPOD_ENDPOINT_URL or RUNPOD_ENDPOINT_ID with RUNPOD_ENDPOINT_API_KEY.
# Bob exposes authenticated control routes:
# - POST /runpod/serverless/invoke
# - GET  /runpod/serverless/status/:jobId
# RUNPOD_ENDPOINT_ID=<endpoint-id>
# RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/<endpoint-id>/run
# RUNPOD_ENDPOINT_API_KEY=rpa_xxxxxxxxxxxx
# RUNPOD_ENDPOINT_TIMEOUT_MS=120000
# RUNPOD_ENDPOINT_POLL_INTERVAL_MS=3000

OLLAMA_MODEL=qwen2.5:7b

# Bob conversational attitude profile (applies to Bob/Ollama prompt composition)
# Options: operational (default), supportive, strict, coach
BOB_ATTITUDE_PROFILE=operational
# Optional free-form override appended to the profile instructions.
# Example: "Keep responses extra concise for radio playback"
BOB_ATTITUDE_INSTRUCTIONS=

# Chat provider for user-facing assistant responses
# - heuristic => local deterministic responses (fully self-contained, no LLM)
# - ollama    => local LLM responses via OLLAMA_BASE_URL (recommended for production)
#               Ollama runs co-located on the same RunPod pod as Bob.
#               Start Ollama, then: ollama pull qwen2.5:32b  (or qwen2.5:7b for less VRAM)
# NOTE: openai/chatgpt is NOT supported for chat or document generation.
#       Bob and Ollama handle 100% of AI tasks in-house.
CHAT_PROVIDER=ollama
CHAT_HEURISTIC_ENABLED=true
CHAT_TIMEOUT_MS=120000

# Tender / document generation model configuration
# Primary model (used for general chat AND document generation)
# 30 GB pod:  qwen2.5:32b  (~19 GB Q4)   — 2 parallel workers
# 80 GB pod:  qwen2.5:72b  (~41 GB Q4)   — 4 parallel workers
# 141 GB pod: qwen2.5:72b  (~41 GB Q4)   — 8 parallel workers
# OLLAMA_MODEL=qwen2.5:32b
# Writing specialist model — a second model pulled into the same Ollama instance,
# dedicated to tender/document generation. Only set this when the pod has enough
# VRAM for a second resident model (≥60 GB recommended).
# Pull it: ollama pull qwen2.5:32b   (or qwen2.5:72b on 141 GB pods)
# If not set, OLLAMA_MODEL is used for both chat and document generation.
# OLLAMA_MODEL_WRITING=qwen2.5:32b

# Secondary Bob instance for document generation (optional cascade step)
# Deploy a second Bob pod (with a larger Ollama model) that exposes POST /tender/generate.
# Both URL and API key must be set to enable this cascade step.
# SECONDARY_ASSISTANT_URL=https://<second-bob-pod-url>
# SECONDARY_ASSISTANT_API_KEY=your-secret-key
# SECONDARY_ASSISTANT_TIMEOUT_MS=90000

# Self-learning controls
SELF_LEARNING_ENABLED=true
SIMILARITY_THRESHOLD=0.85
SIMILARITY_THRESHOLD_MIN=0.65
SIMILARITY_THRESHOLD_MAX=0.95
SELF_LEARNING_RATE=0.025
SELF_LEARNING_STATE_PATH=./data/self-learning-state.json

# Self-healing bug assistant controls
SELF_HEALING_ENABLED=true

# Local policy/security/jurisdiction intelligence feed (manual or trusted push only)
INTEL_STATE_PATH=./data/intel-state.json
# Optional HMAC key. When set, /intel/ingest-bulletin requires x-intel-signature header.
INTEL_HMAC_KEY=

# Feed harvester controls
# INTEL_FEED_URLS can be comma-separated or newline-separated URLs.
INTEL_FEED_URLS=
INTEL_ALLOWED_HOSTS=
INTEL_FETCH_TIMEOUT_MS=15000
INTEL_MAX_ITEMS_PER_FEED=5
INTEL_MAX_SUMMARY_LENGTH=1200
INTEL_DRY_RUN=false

# Optional Supabase DB sync controls for harvested notices.
INTEL_ENABLE_DB_SYNC=false
INTEL_ORGANIZATION_ID=
INTEL_DB_TABLE=external_intel_bulletins

# Optional JSON map for location-based safety targeting and neighboring areas.
# Example: {"nelson":["<org-uuid>"],"tasman":["<org-uuid>"]}
INTEL_REGION_ORG_MAP={}

# Optional self-learning pretraining profile (used by scripts/pretrain-self-learning.js)
SELF_LEARNING_PRETRAIN_PROFILE=nz-enforcement-v1
SELF_LEARNING_PRETRAIN_MULTIPLIER=12

# Optional API key for internal endpoints like /nlp/tabular/analyze
INFERENCE_API_KEY=

# Safety adapter endpoints (scaffold)
# Enable these only when you have wired concrete runtime models/providers.
# Endpoints affected:
# - GET  /infer/safety/capabilities
# - POST /infer/audio/classify-nuisance
# - POST /infer/video/analyze-action
# - POST /infer/welfare/man-down
# - POST /safety/emergency/hot-mic/trigger
# Audio nuisance classifier (noise complaints — NZ RMA s.326)
# Provider options:
#   none   — disabled (heuristic pipeline only)
#   onnx   — YAMNet ONNX (local, no cloud dependency)
#            Requires: node scripts/download-models.js to fetch models/yamnet.onnx
#            Override model path: SAFETY_AUDIO_CLASSIFIER_MODEL=./models/yamnet.onnx
# To enable:
#   SAFETY_AUDIO_CLASSIFIER_ENABLED=true
#   SAFETY_AUDIO_CLASSIFIER_PROVIDER=onnx
SAFETY_AUDIO_CLASSIFIER_ENABLED=false
SAFETY_AUDIO_CLASSIFIER_PROVIDER=none
SAFETY_AUDIO_CLASSIFIER_MODEL=./models/yamnet.onnx

SAFETY_ACTION_RECOGNITION_ENABLED=false
SAFETY_ACTION_RECOGNITION_PROVIDER=none
SAFETY_ACTION_RECOGNITION_MODEL=

SAFETY_MAN_DOWN_MODEL_ENABLED=false
SAFETY_MAN_DOWN_MODEL_PROVIDER=none
SAFETY_MAN_DOWN_MODEL=

SAFETY_EMERGENCY_HOT_MIC_ENABLED=false

# Supabase JWT verification for internal endpoints (optional)
# When set, /nlp/tabular/analyze accepts Authorization: Bearer <supabase_jwt>
SUPABASE_URL=https://kxwjcupuxnnbnzcgmkoi.supabase.co
SUPABASE_JWKS_URL=https://kxwjcupuxnnbnzcgmkoi.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://kxwjcupuxnnbnzcgmkoi.supabase.co/auth/v1
# Optional audience constraint. Leave blank unless your JWTs use a custom aud claim.
SUPABASE_JWT_AUDIENCE=

# Supabase service-role key — used by Bob for DB access and as an alternative
# auth credential via x-inference-api-key header.  Set in Railway service vars.
# Do NOT expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (optional — used ONLY when VEHICLE_ATTRS_PROVIDER=openai)
# NOT used for chat, document generation, or tender writing.
# Bob and Ollama handle all document/AI tasks to prevent data leakage.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Monitoring (optional)
SENTRY_DSN=
LOG_LEVEL=info
