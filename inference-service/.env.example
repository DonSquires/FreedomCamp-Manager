# Inference Service Configuration

# Server
PORT=3000
NODE_ENV=production

# Security
ALLOWED_ORIGINS=https://kxwjcupuxnnbnzcgmkoi.supabase.co

# When true, disables outbound cloud provider calls (OpenAI, Plate Recognizer).
# Local ONNX and local OCR paths remain available.
SELF_CONTAINED_MODE=true

# When true, service will refuse startup unless SELF_CONTAINED_MODE=true.
# Use this for government/high-assurance deployments.
REQUIRE_SELF_CONTAINED_MODE=true

# Model Configuration
YOLO_MODEL_PATH=./models/yolov8n.onnx
EMBEDDING_MODEL_PATH=./models/mobilenet_v3.onnx

# Performance
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
REQUEST_TIMEOUT=30000     # 30 seconds

# Vehicle attribute provider
# - basic  => local dominant-colour estimate only
# - openai => make/model/year/colour + sticker via OpenAI vision API
VEHICLE_ATTRS_PROVIDER=basic
ATTR_TIMEOUT_MS=2500

# Tabular NLP provider for CSV/XLSX metadata analysis
# - heuristic => local deterministic analysis (no external providers)
# - ollama    => local LLM via OLLAMA_BASE_URL (falls back to heuristic)
TABULAR_NLP_PROVIDER=heuristic
TABULAR_NLP_TIMEOUT_MS=2500
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Optional API key for internal endpoints like /nlp/tabular/analyze
INFERENCE_API_KEY=

# Supabase JWT verification for internal endpoints (optional)
# When set, /nlp/tabular/analyze accepts Authorization: Bearer <supabase_jwt>
SUPABASE_URL=https://kxwjcupuxnnbnzcgmkoi.supabase.co
SUPABASE_JWKS_URL=https://kxwjcupuxnnbnzcgmkoi.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://kxwjcupuxnnbnzcgmkoi.supabase.co/auth/v1
# Optional audience constraint. Leave blank unless your JWTs use a custom aud claim.
SUPABASE_JWT_AUDIENCE=

# OpenAI (optional — used when VEHICLE_ATTRS_PROVIDER=openai)
# Get key: https://platform.openai.com/api-keys → Create new secret key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Monitoring (optional)
SENTRY_DSN=
LOG_LEVEL=info
