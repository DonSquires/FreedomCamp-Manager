# Gitea runtime
GITEA__server__ROOT_URL=https://gitea.example.com/
GITEA__server__SSH_DOMAIN=gitea.example.com
GITEA__server__DOMAIN=gitea.example.com
GITEA__server__HTTP_PORT=3000

# Database connection for the existing Supabase PostgreSQL instance.
# Supply the actual Supabase host/user/password values through Railway secrets.
GITEA__database__DB_TYPE=postgres
GITEA__database__HOST=db.example.supabase.co:5432
GITEA__database__NAME=postgres
GITEA__database__USER=postgres
GITEA__database__PASSWD=replace-me
GITEA__database__SCHEMA=gitea_core
GITEA__database__SSL_MODE=require

# Optional hardening and local defaults.
GITEA__security__INSTALL_LOCK=true
GITEA__service__DISABLE_REGISTRATION=true