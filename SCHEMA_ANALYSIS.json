        "lines": "327-345",
        "type": "Route Guard Component",
        "description": "RoleRoute component - enforces role-based access control",
        "code_snippet": "function RoleRoute({ children, allowedRoles }: { children: React.ReactNode; allowedRoles: string[] }) {\n  const { user } = useAuthStore()\n  if (!user) return <Navigate to='/login' replace />\n  if (user.role === 'grand_master') return <>{children}</>\n  if (!allowedRoles.includes(user.role)) return <Navigate to='/' replace />\n  return <>{children}</>\n}",
        "complexity": "simple"
      },
      {
        "file": "[src/App.tsx](src/App.tsx#L358)",
        "lines": "358-383",
        "type": "Route Guard Component",
        "description": "AreaRoute component - extends RoleRoute with portal-area access control",
        "code_snippet": "function AreaRoute({ children, allowedRoles, area }: { children: React.ReactNode; allowedRoles: string[]; area: string }) {\n  const { user } = useAuthStore()\n  if (!user) return <Navigate to='/login' replace />\n  const isSuperUser = user.role === 'grand_master' || user.role === 'master'\n  if (!isSuperUser && !allowedRoles.includes(user.role)) return <Navigate to='/' replace />\n  if (!isSuperUser && user.portal_access && user.portal_access.length > 0) {\n    if (!user.portal_access.includes(area)) return <Navigate to='/' replace />\n  }\n  return <>{children}</>\n}",
        "complexity": "medium"
      },
      {
        "file": "[src/App.tsx](src/App.tsx#L247)",
        "lines": "247-324",
        "type": "Route Guard Component",
        "description": "ProtectedRoute component - enforces authentication and handles role-specific redirects",
        "code_snippet": "function ProtectedRoute({ children }: { children: React.ReactNode }) {\n  const { user, loading } = useAuthStore()\n  // Special handling for admin_officer (portal choice)\n  // Special handling for nzscv_monitor (limited routes)\n  // Special handling for grand_master (platform redirect)\n  // Special handling for client_viewer (portal redirect)\n  return <>{children}</>\n}",
        "complexity": "medium",
        "special_cases": [
          "admin_officer check for hasPortalChoice (line 262-275)",
          "nzscv_monitor whitelist check (line 277-282)",
          "grand_master home redirect (line 284-288)",
          "client_viewer portal redirect (line 290-295)"
        ]
      },
