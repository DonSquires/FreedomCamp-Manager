        "code_snippet": "const { data: profile, error: profileError } = await (supabase.from('user_profiles') as any)\n  .select('id, email, role, organization_id, employer_organization_id, first_name, last_name, portal_access, authorized_work_locations, extra_organization_ids')\n  .eq('id', session.user.id)\n  .single()",
        "complexity": "simple"
      }
