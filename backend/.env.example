# -----------------------------------------------------------------------------
# FieldOps Backend Environment Template
# -----------------------------------------------------------------------------

# Supabase (backend-only, never expose service role key to browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: JWT validation secret for local token verification path.
SUPABASE_JWT_SECRET=
# Optional project ref fallback if SUPABASE_URL is not supplied.
SUPABASE_PROJECT_REF=

# Live service URLs pulled from the current workspace .env (non-secret values).
INFERENCE_SERVICE_URL=https://api.runpod.ai/v2/n0bp1ifmq01cx2
BOB_SERVICE_URL=https://api.runpod.ai/v2/n0bp1ifmq01cx2
PTT_SERVER_URL=https://ptt.fcmanager.co.nz

# Startup behavior
# false = start in degraded mode when Supabase env is missing (health still available)
# true  = fail fast if Supabase env is incomplete
STRICT_STARTUP=false

# Server
PORT=3000
NODE_ENV=production
APP_ENV=production

# CORS (comma separated)
CORS_ALLOW_ORIGINS=https://fcmanager.co.nz,https://www.fcmanager.co.nz
FRONTEND_ORIGIN=https://fcmanager.co.nz

# Ollama / inference selection
OLLAMA_PROXY_URL=http://ollama:11434
MODEL_GATEWAY_URL=
BOB_CHAT_MODEL=
BOB_CHAT_MODELS=
OLLAMA_CHAT_MODEL=
OLLAMA_MAX_CANDIDATES=3
OLLAMA_MODEL_TIMEOUT_MS=7000
OLLAMA_TOTAL_TIMEOUT_MS=18000
OLLAMA_STREAM_TIMEOUT_MS=25000

# Self-hosted mapping gateway (primary routing) with optional Google support
MAPPING_GATEWAY_URL=
MAPPING_GATEWAY_TIMEOUT_MS=12000
GOOGLE_MAPS_API_KEY=
GOOGLE_API_KEY=

# API and auth timeouts
CHAT_DB_TIMEOUT_MS=2500
CHAT_CONTEXT_TIMEOUT_MS=3500
SUPABASE_AUTH_LOOKUP_TIMEOUT_MS=3000

# Privacy and indexing
PRIVACY_REDACTION_ENABLED=true
DOC_INTEL_INDEX_PATH=
DOC_INTEL_DEFAULT_LIMIT=20
DOC_INTEL_MAX_LIMIT=100

# Gitea integration (for /api/gitea/*)
GITEA_BASE_URL=https://gitea.example.com
GITEA_TOKEN=your-gitea-api-token
GITEA_OWNER=your-org-or-user
GITEA_REPO=your-repository-name
GITEA_BASE_BRANCH=main
GITEA_BRANCH_PREFIX=bob/
AUTOMATION_WEBHOOK_TOKEN=
GITEA_WEBHOOK_SECRET=

# Auto promotion behavior
AUTO_PROMOTE_GREEN_PLAYWRIGHT=true
AUTO_PROMOTE_BASE_BRANCH=main

# Optional Railway scoping for status/intel flows
RAILWAY_TOKEN=
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_CORE_PROJECT_ID=
RAILWAY_PROXY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_PRODUCTION_ENVIRONMENT_ID=
RAILWAY_PROXY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_BACKEND_SERVICE_ID=
RAILWAY_PROXY_SERVICE_ID=
RAILWAY_INFERENCE_SERVICE_ID=
RAILWAY_PTT_SERVICE_ID=

# Shared service URLs used by backend scripts and local diagnostics
PROXY_SERVER_URL=
PTT_SERVER_URL=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
INFERENCE_SERVICE_URL=
INFERENCE_API_KEY=
BOB_SERVICE_URL=
BOB_INFERENCE_API_KEY=

# Optional frontend alias used in some local/dev deployments
VITE_SUPABASE_URL=
