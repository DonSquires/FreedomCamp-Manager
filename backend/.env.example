# Supabase (service role — backend only, never expose to client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Railway deployment
RAILWAY_API_TOKEN=your-railway-api-token

# Ollama proxy (defaults to http://ollama:11434 if not set)
OLLAMA_PROXY_URL=http://ollama:11434

# Server port (optional, defaults to 3000)
PORT=3000

# Gitea integration (for /api/gitea/propose-pr)
GITEA_BASE_URL=https://gitea.example.com
GITEA_TOKEN=your-gitea-api-token
GITEA_OWNER=your-org-or-user
GITEA_REPO=your-repository-name
GITEA_BASE_BRANCH=main
GITEA_BRANCH_PREFIX=bob/
