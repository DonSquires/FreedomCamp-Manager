{
  "name": "fieldops-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10 <11"
  },
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/verify-toolchain.mjs",
    "prestart": "node scripts/verify-toolchain.mjs",
    "build": "bash scripts/bob-env-run.sh run build:raw",
    "build:raw": "tsc",
    "start": "bash scripts/bob-env-run.sh run start:raw",
    "start:raw": "node dist/index.js",
    "dev": "bash scripts/bob-env-run.sh run dev:raw",
    "dev:raw": "npm run start:raw",
    "train:sync": "bash scripts/bob-env-run.sh run train:sync:raw",
    "train:sync:raw": "bash scripts/supabase-gen-types.sh && node --loader ts-node/esm scripts/sync-training.ts",
    "train:validate": "bash scripts/bob-env-run.sh run train:validate:raw",
    "train:validate:raw": "bash scripts/supabase-gen-types.sh && npm run build:raw",
    "docs:sync": "node --loader ts-node/esm scripts/sync-docs.ts",
    "logs:stream": "railway logs --project \"$RAILWAY_PROXY_PROJECT_ID\" --environment dd4cf850-e604-458c-869d-da4ad54279db --service fieldops-backend",
    "kb:update:railway": "node --loader ts-node/esm scripts/temp-update-railway-kb.ts",
    "kb:refresh": "npm run kb:update:railway && npm run docs:sync",
    "train:all": "npm run train:sync && npm run docs:sync"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
